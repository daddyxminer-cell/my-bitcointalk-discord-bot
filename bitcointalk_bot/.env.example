# Copy this file to .env and fill in your webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# How often to check, in minutes (only used when running without --once)
CHECK_INTERVAL_MINUTES=15

# true = also post tokens / memecoins (orange). false = only PoW / node coins (blue)
NOTIFY_TOKENS=false

# Board pages to scan per check (40 topics each)
PAGES_TO_SCAN=1

# Ignore topics whose first post is older than this many hours
MAX_AGE_HOURS=24

# true = on the very first start, also post coins from the last 24h. false = post nothing until a brand-new coin appears
POST_ON_FIRST_RUN=false
